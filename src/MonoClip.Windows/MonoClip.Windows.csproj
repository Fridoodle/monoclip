<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>MonoClip.ico</ApplicationIcon>
    <AssemblyName>MonoClip</AssemblyName>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- A tray app with a tiny managed heap: no background GC thread, no PGO instrumentation re-JIT. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <!-- Publish drops framework assemblies that are never referenced, but never cuts code out of the
       ones that are (member-level trimming is unsupported for WinForms and can break reflection). -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <Target Name="MonoClipKeepUsedAssembliesWhole" AfterTargets="PrepareForILLink">
    <ItemGroup>
      <ManagedAssemblyToLink Update="@(ManagedAssemblyToLink)" TrimMode="copyused" />
    </ItemGroup>
  </Target>
  <!-- Debugger/crash-dump helpers and alternative GCs are never loaded by a normal run. -->
  <Target Name="MonoClipDropDiagnostics" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^(mscordaccore.*|mscordbi\.dll|Microsoft\.DiaSymReader\.Native\..*|createdump\.exe|clrgc\.dll|clrgcexp\.dll|clretwrc\.dll)$', RegexOptions.IgnoreCase))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="MonoClip.ico" LogicalName="MonoClip.ico" />
    <ProjectReference Include="../MonoClip.Core/MonoClip.Core.csproj" />
  </ItemGroup>
  <Import Project="../../RuntimeContent.props" />
</Project>
