<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>MonoClip.ico</ApplicationIcon>
    <AssemblyName>MonoClip</AssemblyName>
    <Version>1.3.1</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- A tray app with a tiny managed heap: no background GC thread, no PGO instrumentation re-JIT. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <!-- No trimming: the trimmer rewrites the .NET runtime files, which strips Microsoft's signatures. Unsigned files
       from a downloaded ZIP are each held by Defender's cloud check on first load (slow first start, stutter on the
       first share). Shipped as Microsoft signed them, Defender trusts them by signature. -->
  <PropertyGroup>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <!-- Debugger/crash-dump helpers and alternative GCs are never loaded by a normal run. -->
  <Target Name="MonoClipDropDiagnostics" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^(mscordaccore.*|mscordbi\.dll|Microsoft\.DiaSymReader\.Native\..*|createdump\.exe|clrgc\.dll|clrgcexp\.dll|clretwrc\.dll)$', RegexOptions.IgnoreCase))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="MonoClip.ico" LogicalName="MonoClip.ico" />
    <ProjectReference Include="../MonoClip.Core/MonoClip.Core.csproj" />
  </ItemGroup>
  <Import Project="../../RuntimeContent.props" />
</Project>
